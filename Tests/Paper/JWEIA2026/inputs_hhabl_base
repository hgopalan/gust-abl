# Empty-domain horizontal-homogeneity test on the paper's Askervein set-up: flat ground, wind along x,
# y periodic (8 cells), the same vertical grid (1 m first layer, 1.065, 850.5 m top), 23.4 m cells, 6 km fetch,
# log-law inflow (u* 0.6278, z0 0.03: 8.9 m/s at 10 m), slip top, Rayleigh damping of w from 600 m, 3 levels.
mesh.n_cell           = 256 8 64
mesh.prob_lo          = -3000. -93.75 0.
mesh.prob_hi          =  3000.  93.75 850.5
mesh.is_periodic      = 0 1 0
mesh.max_grid_size    = 64
mesh.dz0              = 1.
mesh.stretch_ratio    = 1.065
mesh.hierarchy_levels = 3

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = periodic
bc.yhi = periodic
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.03
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.6278
bc.inflow_z0        = 0.03
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
bc.rayleigh_zdamp    = 600.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

forcing.gravity  = 0.
turb.tke_floor   = 1.e-6
simplec.w_vnn_cap = 16

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.sequencing     = 1
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
